# Copy to .env.local for local development. Never commit real values.
# Production: set these on the host. Do not put secrets in source or Git.

# -----------------------------------------------------------------------------
# Persistence Mode
# "file"     → use .data/ filesystem (default, existing Windows behavior)
# "postgres" → use PostgreSQL via POSTGRES_URL
# Default: file (never change this default; only set to "postgres" when ready)
ARA_PERSISTENCE=file

# -----------------------------------------------------------------------------
# PostgreSQL (only required when ARA_PERSISTENCE=postgres)
# Never commit real credentials. Use a non-production database for testing.
# Standard PostgreSQL connection string format.
POSTGRES_URL=

# -----------------------------------------------------------------------------
# Dashboard Authentication
# Required in production (and for local login).
ARA_DASHBOARD_PASSWORD=
ARA_SESSION_SECRET=
# Optional. Comma-separated operator usernames.
# If empty, every successful login is an operator.
ARA_OPERATOR_ALLOWLIST=

# -----------------------------------------------------------------------------
# Application
# Required in production. Local development may use http://localhost:3000
# Do not guess a future HTTPS domain here.
ARA_APP_URL=
# Optional alias if ARA_APP_URL is empty.
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Stage 7 — Frontend → Node API (optional)
# When set, browser calls Express for migrated endpoints (sync-history, lateral filters).
# Example local: http://localhost:3001
# Leave empty to keep same-origin Next.js Route Handlers.
# Never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_ARA_API_BASE_URL=

# Server-side only: Next.js rewrites migrated /api paths to Express (cookie-friendly).
# Example: http://127.0.0.1:3001
# Prefer this over NEXT_PUBLIC_ARA_API_BASE_URL when frontend and API share a site.
ARA_NODE_BACKEND_URL=

# Express CORS allow-list when the browser calls Node cross-origin.
# Comma-separated origins only. Never use *.
# Example: http://localhost:3000
# Set on the Node process (backend), not in NEXT_PUBLIC_*.
ARA_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Lateral Dataset
# Optional. Local workbook path on the current machine (Dropbox is OK locally).
# Production must not rely on a personal Windows path in source code.
# If set, the path must exist.
ARA_LATERAL_EXCEL_PATH=
# Required in production. Local value is the existing Master Drive file ID.
ARA_LATERAL_MASTER_DRIVE_FILE_ID=

# -----------------------------------------------------------------------------
# Executive Dataset
# Optional. Local Executive XLSM path for localhost development.
# Do not put a personal machine path in tracked source — only in .env.local.
# If set, the path must exist.
ARA_EXECUTIVE_EXCEL_PATH=
# Optional for localhost. Used when reading Executive Master from Google Drive.
ARA_EXECUTIVE_MASTER_DRIVE_FILE_ID=

# Phase 4A — Executive Gmail → Drive ingestion (optional until configured).
# Exact sender/subject/filename criteria are NOT defined in source.
# Fill these from the real Executive mailbox contract before enabling fetch.
# Do not invent values. Leave empty until known.
ARA_EXECUTIVE_GMAIL_FROM=
ARA_EXECUTIVE_GMAIL_SUBJECT=
ARA_EXECUTIVE_GMAIL_KEYWORDS=
ARA_EXECUTIVE_ATTACHMENT_PATTERN=
ARA_EXECUTIVE_DRIVE_FOLDER_ID=

# Phase 4B — Executive DS → Google Sheet New Sheet
# Optional override. Empty uses the confirmed destination spreadsheet ID.
ARA_EXECUTIVE_NEW_SHEET_SPREADSHEET_ID=

# -----------------------------------------------------------------------------
# Google OAuth (Gmail + Drive)
# Required in production to connect Gmail/Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. If empty, derived as ${ARA_APP_URL}/api/dataset/gmail/oauth/callback
# Do not change Google Cloud redirect registration in this phase.
GOOGLE_GMAIL_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Gmail
# Optional default mailbox / OAuth login_hint.
# Dataset Manager setup.gmailAddress takes precedence when present.
GMAIL_ACCOUNT=
# Optional alias if GMAIL_ACCOUNT is empty.
ARA_GMAIL_ADDRESS=

# -----------------------------------------------------------------------------
# HTTP cron secret — POST /api/cron/lateral
# Required to enable the cron HTTP endpoint.
# Generate with: openssl rand -hex 32
# Callers must send: Authorization: Bearer <CRON_SECRET>
# Never log, commit, or expose this value.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Automatic Lateral scheduler (cron)
# 0 = do not arm cron (recommended until Windows service is approved)
# 1 = arm cron (weekdays 09:00 and 11:00 IST from Dataset setup)
# Production: if unset, cron does NOT arm. Development: if unset, cron arms.
# Manual Dataset → Run All is independent of this flag.
ARA_DATASET_SCHEDULER=

# -----------------------------------------------------------------------------
# Scheduler process ownership (Stage 23)
# next   = Next.js arms lateral node-cron (default; rollback-safe)
# worker = Worker process arms lateral node-cron; Next does not arm cron
ARA_SCHEDULER_OWNER=next

# -----------------------------------------------------------------------------
# Dataset encryption
# Required in production. No development fallback in production.
ARA_DATASET_SETUP_SECRET=
# Optional alias if ARA_DATASET_SETUP_SECRET is empty.
ARA_SETUP_SECRET=

# -----------------------------------------------------------------------------
# Optional. P-Roles pipeline step 19 on non-Windows Docker/VPS:
# unset (default) → headless formula inject (no Excel COM)
# excel           → require Windows Excel COM (legacy)
ARA_P_ROLES_PIPELINE=

