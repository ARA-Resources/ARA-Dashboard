# Backend environment placeholders only. Copy to an untracked local file.
# Never commit real credentials.

PORT=3001

# PostgreSQL (Stage 3+)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Auth verify (Stage 5) — must match Next.js session minting secrets
ARA_SESSION_SECRET=
ARA_DASHBOARD_PASSWORD=
ARA_OPERATOR_ALLOWLIST=

# Stage 7 CORS — comma-separated browser origins (no wildcard)
# Example: http://localhost:3000
ARA_CORS_ORIGINS=
